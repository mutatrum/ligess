LIGESS_USERNAME=dolu
LIGESS_DOMAIN=bips.xyz

# Backend: LND, LNbits, Eclair, CLN, Phoenixd, NWC, LDK, Blink, or Cashu
LIGESS_LN_BACKEND=LND

# Optional Tor SOCKS5 proxy URL
LIGESS_TOR_PROXY_URL=socks5h://127.0.0.1:9050

# 1. LND Configuration (if LIGESS_LN_BACKEND=LND)
LIGESS_LND_REST=https://lnd_rest_api:8080
LIGESS_LND_MACAROON=hex_macaroon_with_invoices_read_write_and_offchain_write

# 2. LNbits Configuration (if LIGESS_LN_BACKEND=LNbits)
# LIGESS_LNBITS_DOMAIN=https://legend.lnbits.com
# LIGESS_LNBITS_API_KEY=your_lnbits_api_key

# 3. Core Lightning (CLN) Configuration (if LIGESS_LN_BACKEND=CLN)
# LIGESS_CLN_REST=https://127.0.0.1:3010
# LIGESS_CLN_MACAROON=hex_macaroon_string
# LIGESS_CLN_RUNE=your_cln_rune_string

# 4. Eclair Configuration (if LIGESS_LN_BACKEND=Eclair)
# LIGESS_ECLAIR_REST=http://127.0.0.1:8082
# LIGESS_ECLAIR_LOGIN=eclair_login
# LIGESS_ECLAIR_PASSWORD=eclair_password

# 5. Phoenixd Configuration (if LIGESS_LN_BACKEND=Phoenixd)
# LIGESS_PHOENIXD_URL=http://127.0.0.1:9740
# LIGESS_PHOENIXD_PASSWORD=your_phoenixd_http_password

# 6. Upstream Nostr Wallet Connect (if LIGESS_LN_BACKEND=NWC)
# Connect to Alby Hub, Umbrel, Zeus, or Mutiny via NWC without opening any node ports
# LIGESS_NWC_URI=nostr+walletconnect://<wallet_pubkey>?relay=<relay_url>&secret=<client_secret>

# 7. LDK Node / LDK Server REST Configuration (if LIGESS_LN_BACKEND=LDK)
# LIGESS_LDK_URL=http://127.0.0.1:3000
# LIGESS_LDK_API_KEY=your_ldk_api_token

# 8. Blink / Galoy GraphQL Configuration (if LIGESS_LN_BACKEND=Blink)
# LIGESS_BLINK_API_KEY=your_blink_api_key
# LIGESS_BLINK_URL=https://api.blink.sv/graphql
# LIGESS_BLINK_WALLET_ID=your_btc_wallet_id # Optional: auto-detected if omitted

# 9. Cashu Mint NUT-04/NUT-05 Gateway (if LIGESS_LN_BACKEND=Cashu)
# LIGESS_CASHU_MINT_URL=https://mint.minibits.cash/Bitcoin

# Nostr Zaps (NIP-57) & Identity (NIP-05)
LIGESS_NOSTR_ZAPPER_PRIVATE_KEY=hex_nostr_private_key_for_zap_publisher
# Optional profile pubkey for NIP-05 verification if different from zapper
# LIGESS_NOSTR_PUBKEY=hex_nostr_pubkey_for_nip05
# Optional list of preferred Nostr relays advertised in NIP-05 (/.well-known/nostr.json)
# LIGESS_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# BIP-352 Silent Payments (Optional static reusable private on-chain Bitcoin address)
# Appended to BIP-353 DNS TXT record (bitcoin:?lno=...&sp=...) and displayed on web portal
# LIGESS_SILENT_PAYMENT_ADDRESS=sp1qq2xg238290...

# LUD-09 LNURL-pay Success Action (Optional thank-you note or URL displayed in paying wallets)
# LIGESS_SUCCESS_MESSAGE=Thank you for supporting sovereign open-source!
# LIGESS_SUCCESS_URL=https://example.com/thanks
# LIGESS_SUCCESS_URL_DESCRIPTION=Thank you! Visit my website:

# LUD-18 Payer Identity (Optional, defaults to true; requests optional name, identifier, email, pubkey)
# LIGESS_PAYER_DATA_ENABLED=true

# LUD-20 Long Payment Description (Optional, defaults to LIGESS_NOSTR_ABOUT if unset)
# LIGESS_LONG_DESCRIPTION=Detailed bio and instructions displayed on wallet pay screens.

# Nostr Profile Metadata (Kind 0 & Web Landing Page)
# Profile info is generated dynamically from your username and domain.
# Customize any field via .env variables:
# LIGESS_NOSTR_DISPLAY_NAME=Alice
# LIGESS_NOSTR_ABOUT=Send Bitcoin instantly via Lightning Address or Nostr Zaps.
# LIGESS_NOSTR_PICTURE=https://example.com/avatar.png
# LIGESS_NOSTR_BANNER=https://example.com/banner.png
# LIGESS_NOSTR_WEBSITE=https://example.com
# (Note: Legacy LIGESS_NOSTR_METADATA_FILE is deprecated and will show a startup warning)

# NIP-61 Nutzaps (Cashu P2PK Ecash Zaps with Auto-Melt into Lightning)
# Allows receiving Cashu ecash nutzaps directly on Nostr and melting them into your node.
# LIGESS_NUTZAP_ENABLED=true
# LIGESS_NUTZAP_PRIVATE_KEY=hex_or_nsec_key # Defaults to LIGESS_NOSTR_ZAPPER_PRIVATE_KEY
# LIGESS_NUTZAP_MINTS=https://mint.minibits.cash/Bitcoin,https://mint.coinos.io
# LIGESS_NUTZAP_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# LIGESS_NUTZAP_AUTO_MELT=true # Automatically converts incoming ecash into native node satoshis

# Nostr Wallet Connect (NIP-47)
LIGESS_NOSTR_WALLET_CONNECT_PRIVATE_KEY=hex_nostr_private_key_for_wallet_connect
LIGESS_NOSTR_WALLET_CONNECT_RELAY=wss://your_domain.com/relay/
LIGESS_NOSTR_WALLET_CONNECT_BUDGET_ZAP=5000
LIGESS_NOSTR_WALLET_CONNECT_BUDGET_HOUR=25000
LIGESS_NOSTR_WALLET_CONNECT_BUDGET_DAY=100000

# NIP-11 Relay Information
# Automatically calculates supported_nips [1, 4, 5, 11, 42, 44, 47, 57, 61], software, and version.
# Optional overrides:
# LIGESS_RELAY_NAME=My Ligess Relay
# LIGESS_RELAY_DESCRIPTION=Personal Lightning Address & Nostr Relay
# LIGESS_RELAY_CONTACT=alice@example.com
# LIGESS_RELAY_ICON=https://example.com/icon.png
# LIGESS_NOSTR_WALLET_CONNECT_PUBLIC_KEY=hex_nostr_public_key_for_nip42_auth_optional
# (Note: Legacy LIGESS_NOSTR_RELAY_INFORMATION is deprecated and will show a startup warning)

# LNDK BOLT12 Configuration (Optional)
# LIGESS_LNDK_ENABLED=false
# LIGESS_LNDK_GRPC_HOST=127.0.0.1:7000
# LIGESS_LNDK_TLS_CERT=/path/to/lndk/tls.cert
# LIGESS_LNDK_MACAROON_HEX=hex_lnd_macaroon